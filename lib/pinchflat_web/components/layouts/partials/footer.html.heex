<footer class="border-t border-strokedark">
  <div class="mx-auto flex max-w-screen-2xl flex-col gap-3 px-3 py-4 text-sm text-bodydark2 sm:flex-row sm:items-center sm:justify-between sm:px-4 lg:px-6">
    <nav class="flex flex-wrap gap-x-5 gap-y-2">
      <.footer_link icon="hero-book-open" text="Docs" href="https://github.com/kieraneglin/pinchflat/wiki" />
      <.footer_link icon="si-github" text="Github" href="https://github.com/kieraneglin/pinchflat" />
      <.footer_link icon="si-discord" text="Discord" href="https://discord.gg/j7T6dCuwU4" />
      <button type="button" class="flex items-center gap-1.5 hover:text-white" phx-click={show_modal("donate-modal")}>
        <.icon name="hero-currency-dollar" class="h-4 w-4" /> Donate
      </button>
    </nav>
    <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs">
      <span class="flex items-center gap-2" x-on:click={"markVersionAsSeen('#{Application.spec(:pinchflat)[:vsn]}')"}>
        <span>Pinchflat {Application.spec(:pinchflat)[:vsn]}</span>
        <a
          href="https://github.com/kieraneglin/pinchflat/releases"
          target="_blank"
          class="bg-primary text-white px-1.5 rounded-full text-[10px] font-semibold"
          x-cloak
          x-show={"!isVersionSeen('#{Application.spec(:pinchflat)[:vsn]}')"}
        >
          NEW
        </a>
      </span>
      <span>yt-dlp {Settings.get!(:yt_dlp_version)}</span>
    </div>
  </div>
</footer>

package web

templ SourceHTMLIndex(state *sourceIndexTableState) {
	<div class="page-header">
		<h2 class="page-title">Sources</h2>
		<nav class="flex items-center justify-between gap-6">
			<a
				href={ templ.URL(OpmlFeedURL(ctx)) }
				data-copy={ OpmlFeedURL(ctx) }
			>
				Copy OPML <span class="hidden sm:inline">Feed</span>
				<span data-copied hidden>
					@CoreIcon("hero-check", "ml-2 h-4 w-4", nil)
				</span>
			</a>
			<a href={ templ.URL(P(ctx, "/sources/new")) }>
				@ButtonButton("bg-primary", "rounded-lg", "", "submit", false, nil, sourceHTMLNewSourceButtonContent())
			</a>
		</nav>
	</div>

	<div class="card overflow-hidden">
		<div class="max-w-full overflow-x-auto">
			@SourceHTMLIndexTable(state)
		</div>
	</div>
}

templ sourceHTMLNewSourceButtonContent() {
	@CoreIcon("hero-plus", "h-4 w-4", nil)
	New <span class="hidden sm:inline pl-1">Source</span>
}

package web

import "github.com/mattbriancon/pinchflat/internal/core"

// Port of lib/pinchflat_web/controllers/settings/setting_html/show.html.heex.

templ SettingHTMLShow(changeset *core.Changeset) {
	<div class="page-header">
		<div class="flex gap-3 items-center">
			<h2 class="page-title">
				Settings
			</h2>
		</div>
	</div>
	<div class="card card-body">
		<div class="max-w-full">
			@SettingHTMLSettingForm(changeset, "/settings")
		</div>
	</div>
}

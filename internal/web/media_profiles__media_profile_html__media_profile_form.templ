package web

// Port of lib/pinchflat_web/controllers/media_profiles/media_profile_html/media_profile_form.html.heex.

// MediaProfilesHTMLMediaProfileForm is media_profile_form/1. Callers build f
// with FormFor(changeset, "media_profile"), matching the `:let={f}` in the
// Elixir source.
templ MediaProfilesHTMLMediaProfileForm(f *Form, action string, method string) {
	<form { mediaProfilesFormAttrs(action)... }>
		if method != "post" {
			<input type="hidden" name="_method" value={ method }/>
		}
		if f.Changeset.Action != "" {
			@CoreError("Oops, something went wrong! Please check the errors below.")
		}

		<section x-data="{ selectedPreset: null }">
			<h3 class="my-3 section-title">
				Use a Preset
			</h3>
			<section x-data="{ selection: null }">
				@CoreInput(CoreInputProps{
					Name:        "media_profile_preset",
					Value:       "",
					Prompt:      "Select preset",
					Options:     mediaProfilesPresetOptions(),
					Type:        "select",
					InputClass:  "w-full",
					Help:        "You can further customize the settings after selecting a preset. This is just a starting point",
					Rest:        templ.Attributes{"x-model": "selection"},
					InputAppend: mediaProfilesPresetLoadButton(),
				})
			</section>

			<section class="flex justify-between items-center mt-8">
				<h3 class="section-title">
					General Options
				</h3>
				<span class="cursor-pointer hover:underline" x-on:click="advancedMode = !advancedMode">
					Editing Mode: <span x-text="advancedMode ? 'Advanced' : 'Standard'"></span>
				</span>
			</section>
			<section x-data="{
        presets: {
          default: 'Default',
          media_center: 'TV Shows',
          audio: 'Music',
          archiving: 'Archiving'
        }
    }">
				@CoreInput(CoreInputProps{
					Field:      mediaProfilesField(f, "name"),
					Type:       "text",
					Label:      "Name",
					Rest:       templ.Attributes{"placeholder": "New Profile", "x-init": "$watch('selectedPreset', p => p && ($el.value = presets[p]))"},
					Help:       "Something descriptive. Does not impact indexing or downloading (required)",
				})
			</section>

			<section x-data={ "{ \n        presets: { \n          default: '" + mediaProfilesDefaultOutputTemplate() + "',\n          media_center: '" + mediaProfilesMediaCenterOutputTemplate() + "',\n          audio: '" + mediaProfilesAudioOutputTemplate() + "',\n          archiving: '" + mediaProfilesDefaultOutputTemplate() + "'\n        }\n    }" }>
				@CoreInput(CoreInputProps{
					Field:      mediaProfilesField(f, "output_path_template"),
					Type:       "text",
					InputClass: "font-mono",
					Label:      "Output path template",
					Help:       "Must end with .{{ ext }}. See below for more details. The default is good for most cases (required)",
					Rest:       templ.Attributes{"x-init": "$watch('selectedPreset', p => p && ($el.value = presets[p]))"},
				})
			</section>

			<h3 class="mt-8 section-title">
				Subtitle Options
			</h3>

			<section x-data="{ presets: { default: true, media_center: true, audio: false, archiving: true } }">
				@CoreInput(CoreInputProps{
					Field: mediaProfilesField(f, "download_subs"),
					Type:  "toggle",
					Label: "Download Subtitles",
					Help:  "Downloads subtitle files alongside media file",
					Rest:  templ.Attributes{"x-init": "$watch('selectedPreset', p => p && (enabled = presets[p]))"},
				})
			</section>

			<section x-data="{ presets: { default: true, media_center: true, audio: false, archiving: true } }">
				@CoreInput(CoreInputProps{
					Field: mediaProfilesField(f, "embed_subs"),
					Type:  "toggle",
					Label: "Embed Subtitles",
					Help:  "Downloads and embeds subtitles in the media file itself, if supported. Unaffected by 'Download Subtitles'",
					Rest:  templ.Attributes{"x-init": "$watch('selectedPreset', p => p && (enabled = presets[p]))"},
				})
			</section>

			<section x-data="{ presets: { default: false, media_center: false, audio: false, archiving: false } }">
				@CoreInput(CoreInputProps{
					Field: mediaProfilesField(f, "download_auto_subs"),
					Type:  "toggle",
					Label: "Use Autogenerated Subtitles",
					Help:  "Prefers normal subs with 'Download Subtitles' or 'Embed Subtitles' but will use autogenerated subs if needed.",
					Rest:  templ.Attributes{"x-init": "$watch('selectedPreset', p => p && (enabled = presets[p]))"},
				})
			</section>

			<section x-data="{ presets: { default: 'en', media_center: 'en', audio: '', archiving: 'all' } }">
				@CoreInput(CoreInputProps{
					Field: mediaProfilesField(f, "sub_langs"),
					Type:  "text",
					Label: "Subtitle Languages",
					Help:  "Use commas for multiple languages (eg: en,de)",
					Rest:  templ.Attributes{"x-init": "$watch('selectedPreset', p => p && ($el.value = presets[p]))"},
				})
			</section>

			<section x-show="advancedMode">
				@CoreInput(CoreInputProps{
					Field: mediaProfilesField(f, "audio_track"),
					Type:  "text",
					Label: "Audio Track Language",
					Help:  "Only works if there are multiple audio tracks. Use either a language code, 'original' for the original audio track, or 'default' for YouTube's preference. Or just leave it blank",
					Rest:  templ.Attributes{"placeholder": "de"},
				})
			</section>

			<h3 class="mt-8 section-title">
				Thumbnail Options
			</h3>

			<section x-data="{ presets: { default: true, media_center: true, audio: false, archiving: true } }">
				@CoreInput(CoreInputProps{
					Field: mediaProfilesField(f, "download_thumbnail"),
					Type:  "toggle",
					Label: "Download Thumbnail",
					Help:  "Downloads thumbnail alongside media file",
					Rest:  templ.Attributes{"x-init": "$watch('selectedPreset', p => p && (enabled = presets[p]))"},
				})
			</section>

			<section x-data="{ presets: { default: true, media_center: true, audio: true, archiving: true } }">
				@CoreInput(CoreInputProps{
					Field: mediaProfilesField(f, "embed_thumbnail"),
					Type:  "toggle",
					Label: "Embed Thumbnail",
					Help:  "Downloads and embeds thumbnail in the media file itself, if supported. Unaffected by 'Download Thumbnail' (recommended)",
					Rest:  templ.Attributes{"x-init": "$watch('selectedPreset', p => p && (enabled = presets[p]))"},
				})
			</section>

			<h3 class="mt-8 section-title">
				Metadata Options
			</h3>

			<section x-data="{ presets: { default: false, media_center: false, audio: false, archiving: true } }">
				@CoreInput(CoreInputProps{
					Field: mediaProfilesField(f, "download_metadata"),
					Type:  "toggle",
					Label: "Download Metadata",
					Help:  "Downloads metadata file alongside media file",
					Rest:  templ.Attributes{"x-init": "$watch('selectedPreset', p => p && (enabled = presets[p]))"},
				})
			</section>

			<section x-data="{ presets: { default: true, media_center: true, audio: true, archiving: true } }">
				@CoreInput(CoreInputProps{
					Field: mediaProfilesField(f, "embed_metadata"),
					Type:  "toggle",
					Label: "Embed Metadata",
					Help:  "Downloads and embeds metadata in the media file itself, if supported. Unaffected by 'Download Metadata' (recommended)",
					Rest:  templ.Attributes{"x-init": "$watch('selectedPreset', p => p && (enabled = presets[p]))"},
				})
			</section>

			<h3 class="mt-8 section-title">
				Release Format Options
			</h3>

			<section x-data="{ presets: { default: 'include', media_center: 'exclude', audio: 'exclude', archiving: 'include' } }">
				@CoreInput(CoreInputProps{
					Field:   mediaProfilesField(f, "shorts_behaviour"),
					Options: mediaProfilesFriendlyFormatTypeOptions(),
					Type:    "select",
					Label:   "Include Shorts",
					Help:    "Experimental. Please report any issues on GitHub",
					Rest:    templ.Attributes{"x-init": "$watch('selectedPreset', p => p && ($el.value = presets[p]))"},
				})
			</section>

			<section x-data="{ presets: { default: 'exclude', media_center: 'exclude', audio: 'exclude', archiving: 'include' } }">
				@CoreInput(CoreInputProps{
					Field:   mediaProfilesField(f, "livestream_behaviour"),
					Options: mediaProfilesFriendlyFormatTypeOptions(),
					Type:    "select",
					Label:   "Include Livestreams",
					Help:    "How to handle past livestreams",
					Rest:    templ.Attributes{"x-init": "$watch('selectedPreset', p => p && ($el.value = presets[p]))"},
				})
			</section>

			<h3 class="mt-8 section-title">
				Quality Options
			</h3>

			<section x-data="{ presets: { default: '1080p', media_center: '1080p', audio: 'audio', archiving: '2160p' } }">
				@CoreInput(CoreInputProps{
					Field:   mediaProfilesField(f, "preferred_resolution"),
					Options: mediaProfilesFriendlyResolutionOptions(),
					Type:    "select",
					Label:   "Preferred Resolution",
					Help:    "Will grab the closest available resolution if your preferred is not available. 'Audio Only' grabs the highest quality m4a",
					Rest:    templ.Attributes{"x-init": "$watch('selectedPreset', p => p && ($el.value = presets[p]))"},
				})
			</section>

			<section x-show="advancedMode">
				@CoreInput(CoreInputProps{
					Field: mediaProfilesField(f, "media_container"),
					Type:  "text",
					Label: "Media Container",
					Help:  "Don't change this if you're going to consume media via Plex. Leave blank for default",
					Rest:  templ.Attributes{"placeholder": "mp4"},
				})
			</section>

			<section x-data="{ presets: { default: null, media_center: 1, audio: null, archiving: 1 } }">
				@CoreInput(CoreInputProps{
					Field: mediaProfilesField(f, "redownload_delay_days"),
					Type:  "number",
					Label: "Redownload Delay (days)",
					Help:  "Delay in days until new media is redownloaded. Redownloading new media can improve its quality or SponsorBlock tags. Leave blank to not redownload",
					Rest:  templ.Attributes{"min": "0", "x-init": "$watch('selectedPreset', p => p && ($el.value = presets[p]))"},
				})
			</section>

			<h3 class="mt-6 section-title">
				Media Center Options
			</h3>
			<p class="text-sm mt-2 max-w-prose">
				Everything in this section is experimental - please open a GitHub issue if you see something odd.
				<strong>
					These options only work if this Media Profile's output template is set to split media into seasons.
				</strong>
				Try the "Media Center" preset if you're not sure.
			</p>

			<section
				x-data="{ presets: { default: false, media_center: true, audio: false, archiving: false } }"
			>
				@CoreInput(CoreInputProps{
					Field:       mediaProfilesField(f, "download_nfo"),
					Type:        "toggle",
					Label:       "Download NFO data",
					Help:        "Downloads NFO data alongside media file for use with Jellyfin, Kodi, etc.",
					Rest:        templ.Attributes{"x-init": "$watch('selectedPreset', p => p && (enabled = presets[p]))"},
				})
			</section>

			<section x-data="{ presets: { default: false, media_center: true, audio: false, archiving: true } }">
				@CoreInput(CoreInputProps{
					Field: mediaProfilesField(f, "download_source_images"),
					Type:  "toggle",
					Label: "Download Series Images",
					Help:  "Downloads poster and banner images for use with Plex, Jellyfin, Kodi, etc. Only works for full channels (not playlists)",
					Rest:  templ.Attributes{"x-init": "$watch('selectedPreset', p => p && (enabled = presets[p]))"},
				})
			</section>

			<h3 class="mt-8 section-title">
				SponsorBlock Options
			</h3>

			<section x-data="{ sponsorblockBehaviour: null }">
				<section x-data="{ presets: { default: 'disabled', media_center: 'disabled', audio: 'disabled', archiving: 'disabled' } }">
					@CoreInput(CoreInputProps{
						Field:   mediaProfilesField(f, "sponsorblock_behaviour"),
						Options: mediaProfilesFriendlySponsorblockOptions(),
						Type:    "select",
						Label:   "SponsorBlock Behaviour",
						Help:    "Action to take when SponsorBlock segments are found. 'Disabled' won't take any action",
						Rest: templ.Attributes{
							"x-model": "sponsorblockBehaviour",
							"x-init":  "\n            sponsorblockBehaviour = $el.value\n            $watch('selectedPreset', p => p && ($el.value = presets[p]))\n          ",
						},
					})
				</section>

				<section x-show="sponsorblockBehaviour !== 'disabled'" x-transition>
					@CoreInput(CoreInputProps{
						Field:   mediaProfilesField(f, "sponsorblock_categories"),
						Options: mediaProfilesFriendlySponsorblockCategories(),
						Type:    "checkbox_group",
						Label:   "SponsorBlock Categories",
					})
				</section>
			</section>

			@ButtonButton("bg-primary", "rounded-lg", "my-6 w-full sm:w-auto", "submit", false, nil, mediaProfilesSaveButtonLabel())
		</section>

		<div class="rounded-sm dark:bg-meta-4 p-4 md:p-6 mb-5">
			@MediaProfilesHTMLOutputTemplateHelp()
		</div>
	</form>
}

templ mediaProfilesSaveButtonLabel() {
	Save Media profile
}

templ mediaProfilesPresetLoadButton() {
	@ButtonButton("bg-primary", "rounded", "h-13 w-2/5 lg:w-1/5 ml-2 md:ml-4", "button", false, templ.Attributes{
		"x-on:click":      "selectedPreset = selection; selection = null",
		"x-bind:disabled": "!selection",
	}, mediaProfilesPresetLoadButtonLabel())
}

templ mediaProfilesPresetLoadButtonLabel() {
	<span x-text="selection ? 'Load' : 'Select'">Select</span><span class="hidden lg:inline ml-1">Preset</span>
}

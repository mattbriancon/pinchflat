package web

import "github.com/mattbriancon/pinchflat/internal/store"

templ SettingHTMLSettingForm(changeset *store.Changeset, action string) {
	<form
		method="post"
		action={ action }
		x-data="{advancedMode: !!JSON.parse(localStorage.getItem('advancedMode'))}"
		x-init="$watch('advancedMode', value => localStorage.setItem('advancedMode', JSON.stringify(value)))"
	>
		// Ecto.Changeset with a persisted (loaded) struct -> Phoenix.HTML.Form
		// defaults to method "put", carried over the wire with the standard
		// _method override hidden field (there is no CSRF token to emit; Go's
		// cross-origin protection replaces it).
		<input type="hidden" name="_method" value="put"/>
		@formContent(FormFor(changeset, "setting"))
		@ButtonButton("bg-primary", "rounded-lg", "mt-6 mb-2 w-full sm:w-auto", "submit", false, nil, saveSettingsButtonContent())
	</form>
}

templ saveSettingsButtonContent() {
	Save Settings
}

// Helper that will be implemented in Go: we need to get the core package reference
templ formContent(f *Form) {
	if f.HasErrors() {
		@CoreError("Oops, something went wrong! Please check the errors below.")
	}

	<section class="mt-4">
		<section>
			<section class="flex justify-between items-center">
				<h3 class="section-title">
					Extractor Settings
				</h3>
				<span class="cursor-pointer hover:underline" x-on:click="advancedMode = !advancedMode">
					Editing Mode: <span x-text="advancedMode ? 'Advanced' : 'Standard'"></span>
				</span>
			</section>

			@renderFormFieldInput(f, "youtube_api_key", "YouTube API Key(s)", "text", YoutubeAPIHelp(), true, "font-mono text-sm mr-4")
			@renderFormFieldInput(f, "extractor_sleep_interval_seconds", "Sleep Interval (seconds)", "number", "Sleep interval in seconds between each extractor request. Must be a positive whole number. Set to 0 to disable", false, "")
			@renderFormFieldInput(f, "download_throughput_limit", "Download Throughput", "text", "Sets the max bytes-per-second throughput when downloading media. Examples: '50K' or '4.2M'. Leave blank to disable", false, "")
			@renderFormFieldToggle(f, "restrict_filenames", "Restrict Filenames", "Restrict filenames to only ASCII characters and avoid ampersands/spaces in filenames")
		</section>
	</section>

	<section class="mt-8" x-show="advancedMode">
		<section>
			<h3 class="section-title">
				Codec Options
			</h3>

			<p class="text-sm mt-2 max-w-prose">
				The best available codec will be used if your preferred codecs are not found
			</p>

			@renderFormFieldInput(f, "video_codec_preference", "Video Codec Preference", "text", "Video codec preference. Will be remuxed into an MP4 container. See below for more details", false, "font-mono text-sm mr-4")
			@renderFormFieldInput(f, "audio_codec_preference", "Audio Codec Preference", "text", "Audio codec preference. See below for more details", false, "font-mono text-sm mr-4")
		</section>

		<div class="rounded-sm dark:bg-meta-4 p-4 md:p-6 mt-5">
			@SettingHTMLCodecSettingsHelp()
		</div>
	</section>
}

templ renderFormFieldInput(f *Form, fieldName string, label string, typ string, help string, htmlHelp bool, inputClass string) {
	@formInputHelper(f, fieldName, label, typ, help, htmlHelp, inputClass)
}

templ renderFormFieldToggle(f *Form, fieldName string, label string, help string) {
	@formToggleHelper(f, fieldName, label, help)
}

templ formInputHelper(f *Form, fieldName string, label string, typ string, help string, htmlHelp bool, inputClass string) {
	@CoreInput(CoreInputProps{
		Field:       getFormFieldPtr(f, fieldName),
		Label:       label,
		Type:        typ,
		Help:        help,
		HTMLHelp:    htmlHelp,
		InputClass:  inputClass,
	})
}

templ formToggleHelper(f *Form, fieldName string, label string, help string) {
	@CoreInput(CoreInputProps{
		Field:       getFormFieldPtr(f, fieldName),
		Label:       label,
		Type:        "toggle",
		Help:        help,
	})
}

// getFormFieldPtr returns a pointer to a FormField for use in CoreInput
func getFormFieldPtr(f *Form, fieldName string) *FormField {
	ff := f.Field(fieldName)
	return &ff
}

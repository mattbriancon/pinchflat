package web

// Port of lib/pinchflat_web/controllers/pages/page_html/job_table_live.ex.

import (
	"context"
	"fmt"

	"github.com/mattbriancon/pinchflat/internal/core"
	"github.com/mattbriancon/pinchflat/internal/db"
)

// PagesPageHTMLJobTableLiveWrapper wraps the job table with htmx.
templ PagesPageHTMLJobTableLiveWrapper(ctx context.Context) {
	<div
		id="job-table"
		hx-get="/_live/jobs"
		hx-trigger="load"
		hx-swap="outerHTML"
	>
		Loading...
	</div>
}

// PagesPageHTMLJobTableLiveContent renders the content of the job table.
templ PagesPageHTMLJobTableLiveContent(ctx context.Context, tasks []*core.Task) {
	if len(tasks) == 0 {
		<div class="mb-4 flex items-center">
			<p>Nothing Here!</p>
		</div>
	} else {
		<div class="max-w-full overflow-x-auto">
			<table class="w-full table-auto bg-boxdark text-sm text-white">
				<thead>
					<tr class="text-left bg-meta-4 border-b border-strokedark">
						<th class="px-3 py-2.5 text-xs font-semibold uppercase tracking-wide text-bodydark2 whitespace-nowrap">Task</th>
						<th class="px-3 py-2.5 text-xs font-semibold uppercase tracking-wide text-bodydark2 whitespace-nowrap cell-wrap">Subject</th>
						<th class="px-3 py-2.5 text-xs font-semibold uppercase tracking-wide text-bodydark2 whitespace-nowrap">Attempt No.</th>
						<th class="px-3 py-2.5 text-xs font-semibold uppercase tracking-wide text-bodydark2 whitespace-nowrap">Started At</th>
					</tr>
				</thead>
				<tbody>
					for _, task := range tasks {
						<tr class="border-b border-strokedark last:border-b-0 hover:bg-meta-4">
							<td class="px-3 py-2 whitespace-nowrap">
								{ mapWorkerToTaskName(task.Job.Worker) }
							</td>
							<td class="px-3 py-2 whitespace-nowrap cell-wrap">
								<a href={ templ.URL(taskToLink(ctx, task)) } class="underline">
									{ taskToRecordName(task) }
								</a>
							</td>
							<td class="px-3 py-2 whitespace-nowrap">
								{ fmt.Sprint(task.Job.Attempt) }
							</td>
							<td class="px-3 py-2 whitespace-nowrap">
								{ jobTableFormatDatetime(task.Job.AttemptedAt) }
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}

func jobTableFormatDatetime(t *db.UTCDateTimeUsec) string {
	if t == nil {
		return ""
	}
	return t.Time.Format("2006-01-02 15:04")
}

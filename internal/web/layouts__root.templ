package web

//
// Deviations (no LiveView/CSRF-cookie session in the Go port):
//   - get_csrf_token()'s meta tag is dropped: CSRF is now
//     net/http.CrossOriginProtection (endpoint.go's protectFromForgery), not
//     a token the client needs to read.
//   - data-socket-path (the LiveView websocket mount point) is dropped: there
//     is no socket to connect (see STRATEGY.md's "No server push").
//   - <.live_title> becomes a plain "Pinchflat" title: nothing in the
//     Elixir app ever assigns @page_title.

templ LayoutsRoot(content templ.Component) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="theme-color" content="#16191E"/>
			<title>Pinchflat</title>
			<link rel="stylesheet" href={ P(ctx, "/assets/app.css") }/>
			<link rel="icon" type="image/x-icon" href={ P(ctx, "/favicon.ico?cachebust=2024-03-20") }/>
			<script defer type="text/javascript" src={ P(ctx, "/assets/app.js") }></script>
		</head>
		<body class="dark text-bodydark bg-boxdark-2">
			@content
		</body>
	</html>
}

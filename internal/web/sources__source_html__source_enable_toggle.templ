package web

// The toggle is a plain form POST to /sources/{id}/enabled that redirects
// back; app.js auto-submits the form when the checkbox changes.

import "fmt"

// SourceEnableToggleRender renders the enabled toggle for a source.
templ SourceEnableToggleRender(sourceID int64, enabled bool) {
	<div>
		<form
			class="enabled_toggle_form"
			method="post"
			action={ templ.URL(P(ctx, "/sources/%v/enabled", sourceID)) }
		>
			@CoreInput(CoreInputProps{
				ID:    fmt.Sprintf("source_%d_enabled_input", sourceID),
				Name:  "source[enabled]",
				Type:  "toggle",
				Value: enabled,
				Rest: templ.Attributes{
					"data-submit-on-change": true,
				},
			})
		</form>
	</div>
}

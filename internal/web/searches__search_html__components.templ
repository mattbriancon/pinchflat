package web

// HighlightSearchTerms renders search terms highlighted in a string of text
// based on `[PF_HIGHLIGHT]` and `[/PF_HIGHLIGHT]` tags.
templ HighlightSearchTerms(text string) {
	for _, fragment := range splitSearchTerms(text) {
		if fragment.highlighted {
			<span class="font-bold italic">{ fragment.text }</span>
		} else {
			{ fragment.text }
		}
	}
}

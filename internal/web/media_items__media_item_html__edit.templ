package web

import (
	"github.com/mattbriancon/pinchflat/internal/store"
)

templ MediaItemsMediaItemHTMLEdit(mediaItem *store.MediaItem, form *Form) {
	<div class="page-header justify-start">
		<h2 class="page-title">
			Editing "
			if mediaItem.Title != nil {
				{ *mediaItem.Title }
			}
			"
		</h2>
	</div>

	<div class="card card-body">
		<div class="max-w-full">
			<div class="flex flex-col gap-6">
				@MediaItemsMediaItemHTMLMediaItemForm(form, P(ctx, "/sources/%v/media/%v", mediaItem.SourceID, mediaItem.ID))
			</div>
		</div>
	</div>
}

package web

// Port of lib/pinchflat_web/controllers/media_items/media_item_html/edit.html.heex

import (
	"github.com/mattbriancon/pinchflat/internal/core"
)

templ MediaItemsMediaItemHTMLEdit(mediaItem *core.MediaItem, changeset *core.Changeset) {
	<div class="page-header justify-start">
		<h2 class="page-title">
			Editing "
			if mediaItem.Title != nil {
				{ *mediaItem.Title }
			}
			"
		</h2>
	</div>

	<div class="card card-body">
		<div class="max-w-full">
			<div class="flex flex-col gap-6">
				@MediaItemsMediaItemHTMLMediaItemForm(changeset, P(ctx, "/sources/%v/media/%v", mediaItem.SourceID, mediaItem.ID))
			</div>
		</div>
	</div>
}

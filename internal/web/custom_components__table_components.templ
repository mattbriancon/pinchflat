package web

// See custom_components__table_components.go for TableProps/TableColumn.

// TableTable is table/1.
templ TableTable(p TableProps) {
	<div class="max-w-full overflow-x-auto">
		<table class={ "w-full table-auto bg-boxdark text-sm", p.TableClass }>
			<thead>
				<tr class="text-left bg-meta-4 border-b border-strokedark">
					for _, col := range p.Columns {
						<th class="px-3 py-2.5 text-xs font-semibold uppercase tracking-wide text-bodydark2 whitespace-nowrap">
							if headerURL := tableHeaderURL(p, col); headerURL != "" {
								<a href={ templ.URL(headerURL) } class="relative flex cursor-pointer hover:text-white">
									{ col.Label }
									if p.SortKey == col.SortKey && col.SortKey != "" {
										@CoreIcon(tableSortIcon(p.SortDirection), "w-3 h-3 mt-0.5 ml-1 absolute", nil)
									}
								</a>
							} else {
								<div class="relative">
									{ col.Label }
								</div>
							}
						</th>
					}
				</tr>
			</thead>
			<tbody>
				for _, row := range p.Rows {
					<tr class="border-b border-strokedark last:border-b-0 hover:bg-meta-4">
						for _, col := range p.Columns {
							<td class={ "px-3 py-2 whitespace-nowrap", col.Class }>
								@col.Render(row)
							</td>
						}
					</tr>
				}
			</tbody>
		</table>
	</div>
}

// TableLivePaginationControls is live_pagination_controls/1. prevURL/nextURL
// are the link targets for "page_change" ("" for none: that direction is
// unavailable, like the Elixir `phx-click={@page_number != 1 && "page_change"}`).
templ TableLivePaginationControls(pageNumber int, totalPages int, prevURL string, nextURL string) {
	<nav>
		<ul class="flex flex-wrap items-center">
			<li>
				if prevURL != "" {
					<a
						href={ templ.URL(prevURL) }
						class="pagination-prev flex h-8 w-8 items-center justify-center rounded cursor-pointer hover:bg-primary hover:text-white"
					>
						@CoreIcon("hero-chevron-left", "", nil)
					</a>
				} else {
					<span class="pagination-prev flex h-8 w-8 items-center justify-center rounded cursor-not-allowed opacity-40">
						@CoreIcon("hero-chevron-left", "", nil)
					</span>
				}
			</li>
			<li>
				<span class="mx-2 text-sm">
					Page
					@TextLocalizedNumber(pageNumber)
					of
					@TextLocalizedNumber(totalPages)
				</span>
			</li>
			<li>
				if nextURL != "" {
					<a
						href={ templ.URL(nextURL) }
						class="pagination-next flex h-8 w-8 items-center justify-center rounded cursor-pointer hover:bg-primary hover:text-white"
					>
						@CoreIcon("hero-chevron-right", "", nil)
					</a>
				} else {
					<span class="pagination-next flex h-8 w-8 items-center justify-center rounded cursor-not-allowed opacity-40">
						@CoreIcon("hero-chevron-right", "", nil)
					</span>
				}
			</li>
		</ul>
	</nav>
}

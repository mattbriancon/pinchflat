package web

import (

	"github.com/mattbriancon/pinchflat/internal/store"
)

templ MediaItemsMediaItemHTMLActionsDropdown(mediaItem *store.MediaItem) {
	@ButtonButtonDropdown("Actions", "justify-center w-full sm:w-50", []ButtonButtonOption{
		{Content: mediaItemsCopyJSONOption(mediaItem)},
		{Content: mediaItemsDividerOption()},
		{Content: mediaItemsForceDownloadOption(mediaItem)},
		{Content: mediaItemsDividerOption()},
		{Content: mediaItemsDeleteFilesOption(mediaItem)},
		{Content: mediaItemsDeleteAndIgnoreOption(mediaItem)},
	})
}

templ mediaItemsDividerOption() {
	<div class="my-1 h-px w-full bg-strokedark"></div>
}

// mediaItemsCopyJSONOption is the <:option> that copies
// Jason.Formatter.pretty_print(Jason.encode!(@media_item)) to the clipboard.
templ mediaItemsCopyJSONOption(mediaItem *store.MediaItem) {
	<span data-copy={ prettyJSON(mediaItem) }>
		Copy JSON
		<span data-copied hidden>
			@CoreIcon("hero-check", "ml-2 h-4 w-4", nil)
		</span>
	</span>
}

templ mediaItemsForceDownloadOption(mediaItem *store.MediaItem) {
	@CoreLinkButton(
		P(ctx, "/sources/%v/media/%v/force_download", mediaItem.SourceID, mediaItem.ID),
		"post",
		"Are you sure you force a download of this media?",
		"w-full text-left",
		mediaItemsForceDownloadText(),
	)
}

templ mediaItemsForceDownloadText() {
	Force Download
}

templ mediaItemsDeleteFilesOption(mediaItem *store.MediaItem) {
	@CoreLinkButton(
		P(ctx, "/sources/%v/media/%v", mediaItem.SourceID, mediaItem.ID),
		"delete",
		"Are you sure you want to delete all files for this media item? This cannot be undone.",
		"w-full text-left",
		mediaItemsDeleteFilesText(),
	)
}

templ mediaItemsDeleteFilesText() {
	Delete Files
}

templ mediaItemsDeleteAndIgnoreOption(mediaItem *store.MediaItem) {
	@CoreLinkButton(
		P(ctx, "/sources/%v/media/%v?prevent_download=true", mediaItem.SourceID, mediaItem.ID),
		"delete",
		"Are you sure you want to delete all files for this media item and prevent it from re-downloading in the future? This cannot be undone.",
		"w-full text-left",
		mediaItemsDeleteAndIgnoreText(),
	)
}

templ mediaItemsDeleteAndIgnoreText() {
	Delete and Ignore
}

package web

// Port of lib/pinchflat_web/controllers/media_items/media_item_html/actions_dropdown.html.heex

import (
	"github.com/mattbriancon/pinchflat/internal/core"
)

templ MediaItemsMediaItemHTMLActionsDropdown(mediaItem *core.MediaItem) {
	<div class="button-dropdown">
		<button type="button" class="justify-center w-full sm:w-50">Actions</button>
		<div class="dropdown-menu">
			<div class="dropdown-option">
				<a href="#" onclick="alert('Copy JSON not yet implemented'); return false;">Copy JSON</a>
			</div>
			<div class="my-1 h-px w-full bg-strokedark"></div>
			<div class="dropdown-option">
				<form method="POST" action={ templ.URL(P(ctx, "/sources/%v/media/%v/force_download", mediaItem.SourceID, mediaItem.ID)) } onsubmit="return confirm('Are you sure you force a download of this media?')">
					<button type="submit" class="w-full text-left">Force Download</button>
				</form>
			</div>
			<div class="my-1 h-px w-full bg-strokedark"></div>
			<div class="dropdown-option">
				<form method="POST" action={ templ.URL(P(ctx, "/sources/%v/media/%v", mediaItem.SourceID, mediaItem.ID)) } onsubmit="return confirm('Are you sure you want to delete all files for this media item? This cannot be undone.')">
					<input type="hidden" name="_method" value="DELETE" />
					<button type="submit" class="w-full text-left">Delete Files</button>
				</form>
			</div>
			<div class="my-1 h-px w-full bg-strokedark"></div>
			<div class="dropdown-option">
				<form method="POST" action={ templ.URL(P(ctx, "/sources/%v/media/%v?prevent_download=true", mediaItem.SourceID, mediaItem.ID)) } onsubmit="return confirm('Are you sure you want to delete all files for this media item and prevent it from re-downloading in the future? This cannot be undone.')">
					<input type="hidden" name="_method" value="DELETE" />
					<button type="submit" class="w-full text-left">Delete and Ignore</button>
				</form>
			</div>
		</div>
	</div>
}

package web

import "github.com/mattbriancon/pinchflat/internal/store"

// MediaProfilesHTMLActionsDropdown is actions_dropdown/1.
templ MediaProfilesHTMLActionsDropdown(mediaProfile *store.MediaProfile) {
	@ButtonButtonDropdown("Actions", "justify-center w-full sm:w-50", []ButtonButtonOption{
		{Content: mediaProfilesCopyJSONOption(mediaProfile)},
		{Content: mediaProfilesUseAsTemplateOption(mediaProfile)},
		{Content: mediaProfilesDividerOption()},
		{Content: mediaProfilesDeleteOption(mediaProfile)},
		{Content: mediaProfilesDeleteWithFilesOption(mediaProfile)},
	})
}

templ mediaProfilesCopyJSONOption(mediaProfile *store.MediaProfile) {
	<span data-copy={ prettyJSON(mediaProfile) }>
		Copy JSON
		<span data-copied hidden>
			@CoreIcon("hero-check", "ml-2 h-4 w-4", nil)
		</span>
	</span>
}

templ mediaProfilesUseAsTemplateOption(mediaProfile *store.MediaProfile) {
	<a href={ templ.SafeURL(P(ctx, "/media_profiles/new?template_id=%v", mediaProfile.ID)) }>
		Use as Template
	</a>
}

templ mediaProfilesDividerOption() {
	<div class="my-1 h-px w-full bg-strokedark"></div>
}

templ mediaProfilesDeleteOption(mediaProfile *store.MediaProfile) {
	@CoreLinkButton(
		P(ctx, "/media_profiles/%v", mediaProfile.ID),
		"delete",
		"Are you sure you want to delete this profile and all its sources (leaving files in place)? This cannot be undone.",
		"",
		mediaProfilesDeleteProfileLabel(),
	)
}

templ mediaProfilesDeleteProfileLabel() {
	Delete Profile
}

templ mediaProfilesDeleteWithFilesOption(mediaProfile *store.MediaProfile) {
	@CoreLinkButton(
		P(ctx, "/media_profiles/%v?delete_files=true", mediaProfile.ID),
		"delete",
		"Are you sure you want to delete this profile, all its sources, and its files on disk? This cannot be undone.",
		"mt-5 md:mt-0",
		mediaProfilesDeleteProfileWithFilesLabel(),
	)
}

templ mediaProfilesDeleteProfileWithFilesLabel() {
	Delete Profile + Files
}

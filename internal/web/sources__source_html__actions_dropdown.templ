package web

// Port of lib/pinchflat_web/controllers/sources/source_html/actions_dropdown.html.heex.

import "github.com/mattbriancon/pinchflat/internal/core"

templ SourceHTMLActionsDropdown(source *core.Source) {
	<div class="actions-dropdown">
		<button class="btn" x-data="{open: false}" x-on:click="open = !open">
			Actions
		</button>
		<div x-show="open" class="dropdown-menu">
			<a href={ templ.URL(RssFeedURL(source)) } x-data="{ copied: false }" x-on:click={`
				$event.preventDefault();
				copyWithCallbacks(
					'` + RssFeedURL(source) + `',
					() => copied = true,
					() => copied = false
				)
			`}>
				Copy RSS Feed
				<span x-show="copied">@CoreIcon("hero-check", "ml-2 h-4 w-4", nil)</span>
			</a>
			<hr/>
			<a href={ templ.URL(P(ctx, "/sources/%v/force_download_pending", source.ID)) }
			   hx-post={ P(ctx, "/sources/%v/force_download_pending", source.ID) }
			   hx-confirm="Are you sure you want to force a download of all pending media items?">
				Download Pending
			</a>
			<a href={ templ.URL(P(ctx, "/sources/%v/force_index", source.ID)) }
			   hx-post={ P(ctx, "/sources/%v/force_index", source.ID) }
			   hx-confirm="Are you sure you want to index all content?">
				Force Index
			</a>
			<a href={ templ.URL(P(ctx, "/sources/%v/sync_files_on_disk", source.ID)) }
			   hx-post={ P(ctx, "/sources/%v/sync_files_on_disk", source.ID) }
			   hx-confirm="Are you sure you want to sync files?">
				Sync Files
			</a>
			<hr/>
			<a href={ templ.URL(P(ctx, "/sources/%v", source.ID)) }
			   hx-delete={ P(ctx, "/sources/%v", source.ID) }
			   hx-confirm="Are you sure you want to delete this source?">
				Delete Source
			</a>
		</div>
	</div>
}

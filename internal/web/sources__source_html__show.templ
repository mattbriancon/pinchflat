package web

// Port of lib/pinchflat_web/controllers/sources/source_html/show.html.heex.

import "github.com/mattbriancon/pinchflat/internal/core"

templ SourceHTMLShow(source *core.Source, pendingTasks []*core.Task) {
	<div class="page-header">
		<div class="flex gap-3 items-center min-w-0">
			<a href={ templ.URL(P(ctx, "/sources")) }>
				@CoreIcon("hero-arrow-left", "back-link", nil)
			</a>
			<h2 class="page-title">
				{ source.CustomName }
			</h2>
		</div>
		<nav>
			<a href={ templ.URL(P(ctx, "/sources/%v/edit", source.ID)) }>
				@ButtonButton("bg-primary", "rounded-lg", "", "submit", false, nil, sourceHTMLEditSourceButtonContent())
			</a>
		</nav>
	</div>
	<div class="card card-body">
		<div class="max-w-full">
			@TabTabbedLayout(sourceHTMLShowTabs(source, pendingTasks), sourceHTMLShowTabAppend(source))
		</div>
	</div>
}

templ sourceHTMLEditSourceButtonContent() {
	@CoreIcon("hero-pencil-square", "h-4 w-4", nil)
	Edit <span class="hidden sm:inline pl-1">Source</span>
}

templ sourceHTMLShowTabAppend(source *core.Source) {
	@SourceHTMLActionsDropdown(source)
}

func sourceHTMLShowTabs(source *core.Source, pendingTasks []*core.Task) []TabTab {
	return []TabTab{
		{ID: "source", Title: "Source", Content: sourceHTMLShowSourceTab(source)},
		{ID: "pending", Title: "Pending", Content: SourceHTMLMediaItemTableLiveWrapper(source.ID, "pending")},
		{ID: "downloaded", Title: "Downloaded", Content: SourceHTMLMediaItemTableLiveWrapper(source.ID, "downloaded")},
		{ID: "other", Title: "Other", Content: SourceHTMLMediaItemTableLiveWrapper(source.ID, "other")},
		{ID: "tasks", Title: "Tasks", Content: sourceHTMLShowTasksTab(pendingTasks)},
	}
}

templ sourceHTMLShowSourceTab(source *core.Source) {
	<div class="flex flex-col text-white gap-6">
		<section>
			<h3 class="section-title mt-2 mb-2">Raw Attributes</h3>
			<section>
				<strong>Media Profile:</strong>
				@TextSubtleLink(P(ctx, "/media_profiles/%v", source.MediaProfileID), "", sourceHTMLMediaProfileName(source))
			</section>
			@CoreListItemsFromMap(source)
		</section>
	</div>
}

templ sourceHTMLMediaProfileName(source *core.Source) {
	if source.MediaProfile != nil {
		{ source.MediaProfile.Name }
	}
}

templ sourceHTMLShowTasksTab(pendingTasks []*core.Task) {
	if len(pendingTasks) > 0 {
		@TableTable(TableProps{
			Rows:       sourceHTMLTaskRows(pendingTasks),
			TableClass: "text-black dark:text-white",
			Columns: []TableColumn{
				{Label: "Worker", Render: func(row any) templ.Component { return sourceHTMLTaskWorkerCell(row.(*core.Task)) }},
				{Label: "State", Render: func(row any) templ.Component { return sourceHTMLTaskStateCell(row.(*core.Task)) }},
				{Label: "Scheduled At", Render: func(row any) templ.Component { return sourceHTMLTaskScheduledAtCell(row.(*core.Task)) }},
			},
		})
	} else {
		<p>Nothing Here!</p>
	}
}

func sourceHTMLTaskRows(tasks []*core.Task) []any {
	out := make([]any, len(tasks))
	for i, t := range tasks {
		out[i] = t
	}
	return out
}

templ sourceHTMLTaskWorkerCell(task *core.Task) {
	{ task.Job.Worker }
}

templ sourceHTMLTaskStateCell(task *core.Task) {
	{ task.Job.State }
}

templ sourceHTMLTaskScheduledAtCell(task *core.Task) {
	@TextDatetimeInZone(task.Job.ScheduledAt.Time, "", "")
}

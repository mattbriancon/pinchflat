package web

// Port of lib/pinchflat_web/controllers/sources/source_live/source_enable_toggle.ex's
// render/1 (an inline ~H template, so there's no separate .heex source).
// phx-change + phx-target become an hx-post on the toggle's hidden input,
// fired on the "change" event the toggle's Alpine dispatches.

import "fmt"

// SourceEnableToggleRender is render/1 (update/2's assigns.form is
// Sources.change_source(%Source{}, source), whose only visible effect here
// is the current `enabled` value).
templ SourceEnableToggleRender(sourceID int64, enabled bool) {
	<div>
		<form class="enabled_toggle_form">
			@CoreInput(CoreInputProps{
				ID:    fmt.Sprintf("source_%d_enabled_input", sourceID),
				Name:  "source[enabled]",
				Type:  "toggle",
				Value: enabled,
				Rest: templ.Attributes{
					"hx-post":    P(ctx, "/_live/sources/%v/enabled", sourceID),
					"hx-trigger": "change",
					"hx-swap":    "none",
				},
			})
		</form>
	</div>
}

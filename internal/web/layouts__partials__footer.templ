package web

// Application.spec(:pinchflat)[:vsn] becomes web.Options.Version (see
// layoutsVersion in layouts.go); markVersionAsSeen/isVersionSeen are in
// web/assets/js/alpine_helpers.js.

templ LayoutsPartialsFooter() {
	<footer class="border-t border-strokedark">
		<div class="mx-auto flex max-w-screen-2xl flex-col gap-3 px-3 py-4 text-sm text-bodydark2 sm:flex-row sm:items-center sm:justify-between sm:px-4 lg:px-6">
			<nav class="flex flex-wrap gap-x-5 gap-y-2">
				@LayoutsFooterLink("hero-book-open", "Docs", "https://github.com/kieraneglin/pinchflat/wiki")
				@LayoutsFooterLink("si-github", "Github", "https://github.com/kieraneglin/pinchflat")
				@LayoutsFooterLink("si-discord", "Discord", "https://discord.gg/j7T6dCuwU4")
			</nav>
			<div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs">
				<span class="flex items-center gap-2" x-on:click={ "markVersionAsSeen('" + layoutsVersion(ctx) + "')" }>
					<span>Pinchflat { layoutsVersion(ctx) }</span>
					<a
						href="https://github.com/kieraneglin/pinchflat/releases"
						target="_blank"
						class="bg-primary text-white px-1.5 rounded-full text-[10px] font-semibold"
						x-cloak
						x-show={ "!isVersionSeen('" + layoutsVersion(ctx) + "')" }
					>
						NEW
					</a>
				</span>
				<span>yt-dlp { layoutsYtDlpVersion(ctx) }</span>
			</div>
		</div>
	</footer>
}
